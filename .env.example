APP_NAME=Fast Boiler
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-at-least-32-characters-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fast_boiler
DB_USER=fast_boiler
DB_PASSWORD=fast_boiler
DB_URL=postgresql+psycopg://fast_boiler:fast_boiler@postgres:5432/fast_boiler

BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=8080

VITE_API_BASE_URL=/api/v1

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
